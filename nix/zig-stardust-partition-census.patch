+    fn inputCounts(inputs: anytype) !PartitionInputCounts {
+        var result = PartitionInputCounts{};
+        for (inputs) |input| switch (input) {
+            .object => result.object = try increment(result.object),
+            .archive => result.archive = try increment(result.archive),
+            .res => result.resource = try increment(result.resource),
