+    fn hashPath(io: Io, path: CachePath) !PartitionContentIdentity {
+        const file = try path.root_dir.handle.openFile(
+            io,
+            path.sub_path,
+            .{ .allow_directory = false },
+        );
+        defer file.close(io);
+        return hashFile(io, file);
+    }
+
+    fn hashPartitionMember(
+        io: Io,
+        candidate: PartitionMemberCandidate,
+    ) !PartitionMemberObservation {
+        if (candidate.content) |content| return .{
+            .content = content,
+            .thin_archive = candidate.thin_archive,
+        };
+        const file = try candidate.path.root_dir.handle.openFile(
+            io,
+            candidate.path.sub_path,
+            .{ .allow_directory = false },
+        );
+        defer file.close(io);
