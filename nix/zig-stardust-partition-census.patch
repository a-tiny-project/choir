+    }
+
+    fn hashPartitionFile(
+        io: Io,
+        file: Io.File,
+        kind: PartitionMemberKind,
+    ) !PartitionMemberObservation {
+        return .{
+            .content = try hashFile(io, file),
+            .thin_archive = kind == .archive and try isThinArchive(io, file),
+        };
+    }
