+                        .{
+                            .origin = .foreign,
+                            .kind = .resource,
+                            .path = CachePath.initCwd(success.res_path),
+                            .declaration_source = .win32_resource,
+                            .declaration_ordinal = try count32(index),
+                        },
+                    ),
+                    else => return error.PartitionResourceUnavailable,
+                }
+            }
+        }
+    }
