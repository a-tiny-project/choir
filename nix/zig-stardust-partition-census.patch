+    fn hashGeneratedChild(
+        io: Io,
+        parent: []const u8,
+        role: GeneratedChildRole,
+    ) !GeneratedChildIdentity {
+        var snapshot_path_storage: [Io.Dir.max_path_bytes]u8 = undefined;
+        const snapshot_path = try std.fmt.bufPrint(
+            &snapshot_path_storage,
+            "{s}.member-{s}.choir",
+            .{ parent, @tagName(role) },
+        );
+        var census_path_storage: [Io.Dir.max_path_bytes]u8 = undefined;
+        const census_path = try std.fmt.bufPrint(
+            &census_path_storage,
+            "{s}{s}",
+            .{ snapshot_path, partition_census_suffix },
+        );
+        return .{
+            .role = role,
+            .snapshot = try hashPath(io, CachePath.initCwd(snapshot_path)),
