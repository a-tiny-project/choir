+    fn count32(value: usize) !u32 {
+        return std.math.cast(u32, value) orelse
+            error.PartitionCensusCapacityExceeded;
+    }
+
+    fn increment(value: u32) !u32 {
+        return std.math.add(u32, value, 1) catch
+            error.PartitionCensusCapacityExceeded;
+    }
