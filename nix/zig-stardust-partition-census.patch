+        if (try file.readPositional(io, &.{&extra}, offset) != 0) {
+            return error.PartitionMemberGrewDuringHash;
+        }
+        var digest: [Sha256.digest_length]u8 = undefined;
+        hasher.final(&digest);
+        return .{ .bytes = stat.size, .sha256 = digest };
+    }
