diff --git a/lib/compiler/Maker/Generation.zig b/lib/compiler/Maker/Generation.zig
--- /dev/null
+++ b/lib/compiler/Maker/Generation.zig
@@ -0,0 +1,295 @@
+const Generation = @This();
+const std = @import("std");
+const Io = std.Io;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+const assert = std.debug.assert;
+
+pub const schema = "tiny.zig.generation/v1";
+pub const request_bytes_max = 86;
+pub const frame_bytes_max = 32768;
+pub const stream_bytes_max = 64 * 1024 * 1024;
+pub const generation_count_max = 4096;
+
+file: Io.File,
+request_path: []const u8,
+session: [64]u8,
+runner: [32]u8,
+root_storage: [Io.Dir.max_path_bytes]u8,
+root_length: u16,
+ordinal: u32 = 0,
+offset: u64 = 0,
+disabled: bool = false,
+pending: ?Completed = null,
+
+pub const Counts = struct {
+    total_steps: u64,
+    succeeded_steps: u64,
+    failed_steps: u64,
+    dependency_failed_steps: u64,
+    skipped_steps: u64,
+    tests: u64,
+    passed_tests: u64,
+    skipped_tests: u64,
+    failed_tests: u64,
+    crashed_tests: u64,
+    timed_out_tests: u64,
+};
+
+const Completed = struct { request: Request, counts: Counts };
+
+const Phase = enum { begin, terminal, overflow };
+const Outcome = enum { success, failed, cancelled, unknown };
+const Reason = enum { dispatch_error, generation_limit, stream_limit };
+const RequestState = enum { request, idle, missing, malformed, oversized, unavailable };
+
+pub const Request = struct {
+    state: RequestState,
+    bytes: [request_bytes_max]u8 = undefined,
+    length: ?u8 = null,
+    epoch: ?u64 = null,
+    worktree_sha256: [64]u8 = undefined,
+};
+
+pub fn init(io: Io, environment: *const std.process.Environ.Map, root: Io.Dir) ?Generation {
+    const output = environment.get("TINY_ZIG_GENERATION_EVENTS") orelse return null;
+    const request = environment.get("TINY_ZIG_GENERATION_REQUEST") orelse return null;
+    const session = environment.get("TINY_ZIG_GENERATION_SESSION") orelse return null;
+    const expected_root = environment.get("TINY_ZIG_GENERATION_ROOT") orelse return null;
+    if (!absolute(output) or !absolute(request) or !absolute(expected_root)) return null;
+    if (session.len != 64 or !lowerHex(session)) return null;
+    var result: Generation = .{
+        .file = undefined,
+        .request_path = request,
+        .session = session[0..64].*,
+        .runner = undefined,
+        .root_storage = undefined,
+        .root_length = undefined,
+    };
+    const length = root.realPathFile(io, ".", &result.root_storage) catch |err|
+        return ignored(io, err);
+    const actual = result.root_storage[0..length];
+    if (!std.mem.eql(u8, expected_root, actual)) return null;
+    if (!std.unicode.utf8ValidateSlice(actual)) return null;
+    result.root_length = @intCast(length);
+    const stat = Io.Dir.cwd().statFile(io, output, .{ .follow_symlinks = false }) catch |err|
+        return ignored(io, err);
+    if (stat.kind != .file or stat.size != 0) return null;
+    const file = Io.Dir.openFileAbsolute(io, output, .{
+        .mode = .read_write,
+        .lock = .exclusive,
+        .lock_nonblocking = true,
+        .follow_symlinks = false,
+    }) catch |err| return ignored(io, err);
+    var keep = false;
+    defer if (!keep) file.close(io);
+    const opened = file.stat(io) catch |err| return ignored(io, err);
+    if (opened.kind != .file or opened.size != 0) return null;
+    var random: [16]u8 = undefined;
+    io.randomSecure(&random) catch |err| return ignored(io, err);
+    result.runner = std.fmt.bytesToHex(random, .lower);
+    result.file = file;
+    keep = true;
+    return result;
+}
+
+pub fn deinit(self: *Generation, io: Io) void {
+    self.file.close(io);
+    self.* = undefined;
+}
+
+pub fn begin(self: *Generation, io: Io) ?Request {
+    if (self.disabled) return null;
+    assert(self.ordinal <= generation_count_max);
+    self.ordinal += 1;
+    const request = readRequest(io, self.request_path);
+    if (self.ordinal > generation_count_max) {
+        _ = self.emit(io, request, .overflow, null, .generation_limit, null);
+        self.disabled = true;
+        return null;
+    }
+    if (!self.emit(io, request, .begin, null, null, null)) return null;
+    return request;
+}
+
+pub fn finish(self: *Generation, request: *?Request, counts: Counts) void {
+    const captured = request.* orelse return;
+    request.* = null;
+    assert(counts.total_steps == counts.succeeded_steps + counts.failed_steps +
+        counts.dependency_failed_steps + counts.skipped_steps);
+    assert(counts.tests == counts.passed_tests + counts.skipped_tests + counts.failed_tests +
+        counts.crashed_tests + counts.timed_out_tests);
+    assert(self.pending == null);
+    self.pending = .{ .request = captured, .counts = counts };
+}
+
+pub fn flush(self: *Generation, io: Io) void {
+    const completed = self.pending orelse return;
+    self.pending = null;
+    const outcome: Outcome = if (completed.counts.failed_steps +
+        completed.counts.dependency_failed_steps == 0) .success else .failed;
+    _ = self.emit(io, completed.request, .terminal, outcome, null, completed.counts);
+}
+
+pub fn abort(self: *Generation, io: Io, request: *?Request, err: anyerror) void {
+    const captured = request.* orelse return;
+    request.* = null;
+    const cancelled = err == error.Canceled;
+    _ = self.emit(io, captured, .terminal, if (cancelled) .cancelled else .unknown, if (cancelled) null else .dispatch_error, null);
+}
+
+fn emit(
+    self: *Generation,
+    io: Io,
+    request: Request,
+    phase: Phase,
+    outcome: ?Outcome,
+    reason: ?Reason,
+    counts: ?Counts,
+) bool {
+    if (self.disabled) return false;
+    var storage: [frame_bytes_max]u8 = undefined;
+    var writer: Io.Writer = .fixed(&storage);
+    self.encode(&writer, request, phase, outcome, reason, counts) catch unreachable;
+    const overflow = phase != .overflow and
+        self.offset + writer.end > stream_bytes_max - frame_bytes_max;
+    if (overflow) {
+        writer.end = 0;
+        self.encode(&writer, request, .overflow, null, .stream_limit, null) catch unreachable;
+    }
+    assert(self.offset + writer.end <= stream_bytes_max);
+    const length = self.file.length(io) catch |err| return self.stop(io, err);
+    if (length != self.offset) return self.stop(io, error.StreamChanged);
+    self.file.writePositionalAll(io, writer.buffered(), self.offset) catch |err|
+        return self.stop(io, err);
+    self.offset += writer.end;
+    if (overflow) self.disabled = true;
+    return !overflow;
+}
+
+fn encode(
+    self: *const Generation,
+    writer: *Io.Writer,
+    request: Request,
+    phase: Phase,
+    outcome: ?Outcome,
+    reason: ?Reason,
+    counts: ?Counts,
+) !void {
+    var digest: [Sha256.digest_length]u8 = undefined;
+    var hash: [64]u8 = undefined;
+    var bytes: [request_bytes_max * 2]u8 = undefined;
+    const captured: ?[]const u8 = if (request.length) |length| blk: {
+        Sha256.hash(request.bytes[0..length], &digest, .{});
+        hash = std.fmt.bytesToHex(digest, .lower);
+        const alphabet = "0123456789abcdef";
+        for (request.bytes[0..length], 0..) |byte, index| {
+            bytes[2 * index] = alphabet[byte >> 4];
+            bytes[2 * index + 1] = alphabet[byte & 15];
+        }
+        break :blk bytes[0 .. 2 * @as(usize, length)];
+    } else null;
+    try std.json.Stringify.value(.{
+        .schema = schema,
+        .phase = phase,
+        .session = self.session[0..],
+        .runner = self.runner[0..],
+        .ordinal = self.ordinal,
+        .build_root = self.root_storage[0..self.root_length],
+        .request_state = request.state,
+        .request_hex = captured,
+        .request_sha256 = if (captured != null) hash[0..] else @as(?[]const u8, null),
+        .epoch = request.epoch,
+        .worktree_sha256 = if (request.epoch != null)
+            request.worktree_sha256[0..]
+        else
+            @as(?[]const u8, null),
+        .outcome = outcome,
+        .reason = reason,
+        .counts = counts,
+    }, .{ .escape_unicode = true }, writer);
+    try writer.writeByte('\n');
+}
+
+fn stop(self: *Generation, io: Io, err: anyerror) bool {
+    self.disabled = true;
+    if (err == error.Canceled) io.recancel();
+    return false;
+}
+
+fn ignored(io: Io, err: anyerror) ?Generation {
+    if (err == error.Canceled) io.recancel();
+    return null;
+}
+
+fn readRequest(io: Io, path: []const u8) Request {
+    return read(io, path) catch |err| {
+        if (err == error.Canceled) io.recancel();
+        return .{ .state = if (err == error.FileNotFound) .missing else .unavailable };
+    };
+}
+
+fn read(io: Io, path: []const u8) !Request {
+    const stat = try Io.Dir.cwd().statFile(io, path, .{ .follow_symlinks = false });
+    if (stat.kind != .file) return .{ .state = .unavailable };
+    const file = try Io.Dir.openFileAbsolute(io, path, .{ .follow_symlinks = false });
+    defer file.close(io);
+    const opened = try file.stat(io);
+    if (opened.kind != .file) return .{ .state = .unavailable };
+    if (opened.size > request_bytes_max) return .{ .state = .oversized };
+    var buffer: [request_bytes_max + 1]u8 = undefined;
+    const length = try file.readPositionalAll(io, &buffer, 0);
+    if (length > request_bytes_max) return .{ .state = .oversized };
+    if (length != opened.size or try file.length(io) != length) {
+        return .{ .state = .unavailable };
+    }
+    return parse(buffer[0..length]);
+}
+
+fn parse(bytes: []const u8) Request {
+    assert(bytes.len <= request_bytes_max);
+    var result: Request = .{ .state = .malformed, .length = @intCast(bytes.len) };
+    @memcpy(result.bytes[0..bytes.len], bytes);
+    if (std.mem.eql(u8, bytes, "idle\n")) {
+        result.state = .idle;
+        return result;
+    }
+    const newline = std.mem.indexOfScalar(u8, bytes, '\n') orelse return result;
+    if (newline == 0 or newline > 20 or bytes.len != newline + 66) return result;
+    if (newline > 1 and bytes[0] == '0') return result;
+    for (bytes[0..newline]) |byte| if (!std.ascii.isDigit(byte)) return result;
+    const epoch = std.fmt.parseInt(u64, bytes[0..newline], 10) catch return result;
+    const hash = bytes[newline + 1 ..][0..64];
+    if (!lowerHex(hash) or bytes[bytes.len - 1] != '\n') return result;
+    result.epoch = epoch;
+    result.worktree_sha256 = hash.*;
+    result.state = .request;
+    return result;
+}
+
+fn absolute(path: []const u8) bool {
+    return path.len <= Io.Dir.max_path_bytes and std.fs.path.isAbsolute(path);
+}
+
+fn lowerHex(bytes: []const u8) bool {
+    for (bytes) |byte| if (!std.ascii.isDigit(byte) and (byte < 'a' or byte > 'f')) return false;
+    return true;
+}
+
+test "generation request preserves exact canonical identity at its bound" {
+    const bytes = "18446744073709551615\n" ++ "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ++ "\n";
+    const request = parse(bytes);
+    try std.testing.expectEqual(RequestState.request, request.state);
+    try std.testing.expectEqual(std.math.maxInt(u64), request.epoch.?);
+    try std.testing.expectEqual(request_bytes_max, request.length.?);
+    try std.testing.expectEqualSlices(u8, bytes, request.bytes[0..request.length.?]);
+}
+
+test "generation request distinguishes idle and malformed canonical input" {
+    try std.testing.expectEqual(RequestState.idle, parse("idle\n").state);
+    for ([_][]const u8{ "", "idle", "00\n" ++ "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ++ "\n", "+1\n" ++ "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ++ "\n", "1\n" ++ "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" ++ "\n", "18446744073709551616\n" ++ "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ++ "\n" }) |bytes| {
+        const request = parse(bytes);
+        try std.testing.expectEqual(RequestState.malformed, request.state);
+        try std.testing.expectEqual(null, request.epoch);
+        try std.testing.expectEqualSlices(u8, bytes, request.bytes[0..request.length.?]);
+    }
+}
