+const StardustCompileKind = enum(u3) {
+    @"test",
+    test_obj,
+    exe,
+    lib,
+    obj,
+};
+
+const StardustOptimizeMode = enum(u2) {
+    debug,
+    safe,
+    fast,
+    small,
+};
+
+const StardustUnit = struct {
+    schema: u32,
+    registered_root: []const u8,
+    build_root: []const u8,
+    root_source: []const u8,
+    root_name: []const u8,
+    kind: StardustCompileKind,
+    target: []const u8,
+    cpu: []const u8,
+    object_format: []const u8,
+    dynamic_linker: ?[]const u8,
+    optimize: StardustOptimizeMode,
+};
+
+const StardustBuildIdentity = [Sha256.digest_length * 2]u8;
+
+fn stardustBuildIdentity(
+    maker: *const Maker,
+    compile_index: Configuration.Step.Index,
+    plugin_path: []const u8,
+    zig_args: []const []const u8,
+) StardustBuildIdentity {
+    const graph = maker.graph;
+    var hasher = Sha256.init(.{});
+    updateStardustBuildIdentity(&hasher, "tiny.stardust.build-ticket/v2");
+    updateStardustBuildIdentity(
+        &hasher,
+        graph.build_root_directory.path orelse graph.cache.cwd,
+    );
+    updateStardustBuildIdentity(&hasher, plugin_path);
+    const compile_index_int: u32 = @backingInt(compile_index);
+    hasher.update(mem.asBytes(&compile_index_int));
+    for (zig_args) |arg| updateStardustBuildIdentity(&hasher, arg);
+
+    var identity: [Sha256.digest_length]u8 = undefined;
+    hasher.final(&identity);
+    var identity_hex: StardustBuildIdentity = undefined;
+    _ = std.fmt.bufPrint(&identity_hex, "{x}", .{&identity}) catch unreachable;
+    return identity_hex;
+}
+
+fn markStardustGeneratedRootSkipped(
+    arena: Allocator,
+    maker: *Maker,
+    compile_index: Configuration.Step.Index,
+    session_dir: []const u8,
+    identity: StardustBuildIdentity,
+) Step.ExtendedMakeError!void {
+    const marker_path = try Dir.path.join(arena, &.{
+        session_dir,
+        try arena.print("{s}.generated_root_skipped", .{identity}),
+    });
+    const marker = Dir.cwd().createFile(maker.graph.io, marker_path, .{}) catch |err|
+        return maker.stepByIndex(compile_index).fail(
+            maker,
+            "failed creating Stardust generated-root skip marker {q}: {t}",
+            .{ marker_path, err },
+        );
+    marker.close(maker.graph.io);
+}
+
+fn prepareStardustBuildTicket(
+    arena: Allocator,
+    compile_index: Configuration.Step.Index,
+    maker: *Maker,
+    zig_args: *std.ArrayList([]const u8),
+    fuzz: bool,
+) Step.ExtendedMakeError!?StardustBuildTicket {
+    const graph = maker.graph;
+    const plugin_path = graph.environ_map.get(stardust_build_plugin_env);
+    const session_dir = graph.environ_map.get(stardust_build_session_dir_env);
+    const registered_root = graph.environ_map.get(stardust_build_registered_root_env);
+    const repository_root = graph.environ_map.get(stardust_build_repository_root_env);
+    if (plugin_path == null and
+        session_dir == null and
+        registered_root == null and
+        repository_root == null)
+    {
+        return null;
+    }
+
+    const step = maker.stepByIndex(compile_index);
+    if (plugin_path == null or
+        session_dir == null or
+        registered_root == null or
+        repository_root == null)
+    {
+        return step.fail(
+            maker,
+            "Stardust build session requires {s}, {s}, {s}, and {s}",
+            .{
+                stardust_build_plugin_env,
+                stardust_build_session_dir_env,
+                stardust_build_registered_root_env,
+                stardust_build_repository_root_env,
+            },
+        );
+    }
+    if (!Dir.path.isAbsolute(plugin_path.?) or
+        !Dir.path.isAbsolute(session_dir.?) or
+        !Dir.path.isAbsolute(repository_root.?))
+    {
+        return step.fail(
+            maker,
+            "Stardust build session paths must be absolute: {s}={q} {s}={q} {s}={q}",
+            .{
+                stardust_build_plugin_env,
+                plugin_path.?,
+                stardust_build_session_dir_env,
+                session_dir.?,
+                stardust_build_repository_root_env,
+                repository_root.?,
+            },
+        );
+    }
+    if (!stardustUnitToken(registered_root.?)) return step.fail(
+        maker,
+        "Stardust build registered root {q} is not a stable token",
+        .{registered_root.?},
+    );
+    if (maker.web_server != null or graph.fuzzing or fuzz) {
+        return step.fail(maker, "Stardust build sessions do not support web or fuzzing modes", .{});
+    }
+
+    const conf = &maker.scanned_config.configuration;
+    const conf_comp = compile_index.ptr(conf).extended.get(conf.extra).compile;
+    const root_module = conf_comp.root_module.get(conf);
+    const root_source_index = root_module.root_source_file.unwrap() orelse return null;
+    const identity_hex = stardustBuildIdentity(
+        maker,
+        compile_index,
+        plugin_path.?,
+        zig_args.items,
+    );
+    switch (root_source_index.get(conf)) {
+        .generated => {
+            try markStardustGeneratedRootSkipped(
+                arena,
+                maker,
+                compile_index,
+                session_dir.?,
+                identity_hex,
+            );
+            return null;
+        },
+        else => {},
+    }
+
+    const repository_root_real_z = Dir.realPathFileAbsoluteAlloc(
+        graph.io,
+        repository_root.?,
+        arena,
+    ) catch |err| return step.fail(
+        maker,
+        "failed canonicalizing Stardust repository root {q}: {t}",
+        .{ repository_root.?, err },
+    );
+    const repository_root_real = repository_root_real_z[0..repository_root_real_z.len];
+    if (!mem.eql(u8, repository_root.?, repository_root_real)) return step.fail(
+        maker,
+        "Stardust repository root is not canonical: supplied {q}, canonical {q}",
+        .{ repository_root.?, repository_root_real },
+    );
+    const build_root_input = graph.build_root_directory.path orelse graph.cache.cwd;
+    const build_root_real_z = Dir.cwd().realPathFileAlloc(
+        graph.io,
+        build_root_input,
+        arena,
+    ) catch |err| return step.fail(
+        maker,
+        "failed canonicalizing Stardust build root {q}: {t}",
+        .{ build_root_input, err },
+    );
+    const root_source_input = try maker.resolveLazyPathIndexAbs(
+        arena,
+        root_source_index,
+        compile_index,
+    );
+    const cwd_real_z = Dir.cwd().realPathFileAlloc(
+        graph.io,
+        ".",
+        arena,
+    ) catch |err| return step.fail(
+        maker,
+        "failed canonicalizing Stardust compiler working directory: {t}",
+        .{err},
+    );
+    const root_source_expected = try Dir.path.resolve(arena, &.{
+        cwd_real_z[0..cwd_real_z.len],
+        root_source_input,
+    });
+    const root_source_real_z = Dir.cwd().realPathFileAlloc(
+        graph.io,
+        root_source_input,
+        arena,
+    ) catch |err| return step.fail(
+        maker,
+        "failed canonicalizing Stardust root source {q}: {t}",
+        .{ root_source_input, err },
+    );
+    const root_source_real = root_source_real_z[0..root_source_real_z.len];
+    if (!mem.eql(u8, root_source_expected, root_source_real)) return step.fail(
+        maker,
+        "Stardust root source is not canonical: supplied {q}, expected {q}, actual {q}",
+        .{ root_source_input, root_source_expected, root_source_real },
+    );
+    const build_root = try stardustRepositoryRelativePath(
+        arena,
+        repository_root_real,
+        build_root_real_z[0..build_root_real_z.len],
+        true,
+    ) orelse return step.fail(
+        maker,
+        "Stardust build root {q} is outside repository {q}",
+        .{ build_root_real_z, repository_root_real },
+    );
+    const root_source = try stardustRepositoryRelativePath(
+        arena,
+        repository_root_real,
+        root_source_real,
+        false,
+    ) orelse return step.fail(
+        maker,
+        "Stardust root source {q} is outside repository {q}",
+        .{ root_source_real, repository_root_real },
+    );
+    if (!mem.endsWith(u8, root_source, ".zig") or stardustGeneratedPath(root_source)) {
+        return step.fail(
+            maker,
+            "Stardust root source {q} must be a stable repository Zig source",
+            .{root_source},
+        );
+    }
+
+    const root_name = conf_comp.root_name.slice(conf);
+    const target = conf_comp.rootModuleTarget(conf).unwrapTarget(conf);
+    const target_query = std.Target.Query.fromTarget(&target);
+    const target_text = try target_query.zigTriple(arena);
+    const cpu_text = try target_query.serializeCpuAlloc(arena);
+    const object_format = @tagName(target.ofmt);
+    const dynamic_linker = target.dynamic_linker.get();
+    if (!stardustUnitText(root_name, stardust_unit_text_bytes_max) or
+        !stardustUnitText(target_text, stardust_unit_text_bytes_max) or
+        !stardustUnitText(cpu_text, stardust_unit_text_bytes_max) or
+        !stardustUnitToken(object_format) or
+        (dynamic_linker != null and
+            !stardustUnitText(dynamic_linker.?, stardust_unit_path_bytes_max)))
+    {
+        return step.fail(
+            maker,
+            "Stardust build unit context exceeds the stable schema",
+            .{},
+        );
+    }
+    const unit = StardustUnit{
+        .schema = 1,
+        .registered_root = registered_root.?,
+        .build_root = build_root,
+        .root_source = root_source,
+        .root_name = root_name,
+        .kind = switch (conf_comp.flags3.kind) {
+            .@"test" => .@"test",
+            .test_obj => .test_obj,
+            .exe => .exe,
+            .lib => .lib,
+            .obj => .obj,
+        },
+        .target = target_text,
+        .cpu = cpu_text,
+        .object_format = object_format,
+        .dynamic_linker = dynamic_linker,
+        .optimize = switch (root_module.flags.optimize) {
+            .debug, .default => .debug,
+            .safe => .safe,
+            .fast => .fast,
+            .small => .small,
+        },
+    };
+
+    const expected_path = try Dir.path.join(arena, &.{
+        session_dir.?,
+        try arena.print("{s}.expected", .{identity_hex}),
+    });
+    const artifact_path = try Dir.path.join(arena, &.{
+        session_dir.?,
+        try arena.print("{s}.choir", .{identity_hex}),
+    });
+    const expected_compile_error_path = try Dir.path.join(arena, &.{
+        session_dir.?,
+        try arena.print("{s}.expected_compile_error", .{identity_hex}),
+    });
+    const unit_path = try Dir.path.join(arena, &.{
+        session_dir.?,
+        try arena.print("{s}.unit.json", .{identity_hex}),
+    });
+    try clearStardustArtifactFamily(
+        maker,
+        compile_index,
+        session_dir.?,
+        Dir.path.basename(artifact_path),
+    );
+    Dir.cwd().deleteFile(graph.io, expected_compile_error_path) catch |err| switch (err) {
+        error.FileNotFound => {},
+        else => return step.fail(
+            maker,
+            "failed clearing stale Stardust compile-error terminal {q}: {t}",
+            .{ expected_compile_error_path, err },
+        ),
+    };
+
+    var unit_storage: [stardust_unit_json_bytes_max]u8 = undefined;
+    var unit_writer: std.Io.Writer = .fixed(&unit_storage);
+    std.json.Stringify.value(unit, .{}, &unit_writer) catch |err| return step.fail(
+        maker,
+        "failed encoding Stardust build unit context: {t}",
+        .{err},
+    );
+    const unit_file = Dir.cwd().createFile(graph.io, unit_path, .{}) catch |err|
+        return step.fail(
+            maker,
+            "failed creating Stardust build unit context {q}: {t}",
+            .{ unit_path, err },
+        );
+    defer unit_file.close(graph.io);
+    unit_file.writeStreamingAll(graph.io, unit_writer.buffered()) catch |err|
+        return step.fail(
+            maker,
+            "failed writing Stardust build unit context {q}: {t}",
+            .{ unit_path, err },
+        );
+
+    const expected = Dir.cwd().createFile(graph.io, expected_path, .{}) catch |err|
+        return step.fail(
+            maker,
+            "failed creating Stardust build expectation {q}: {t}",
+            .{ expected_path, err },
+        );
+    expected.close(graph.io);
+
+    if (conf_comp.flags4.expect_errors != .none) return .{
+        .plugin_path = null,
+        .artifact_path = null,
+        .expected_compile_error_path = expected_compile_error_path,
+    };
+
+    return .{
+        .plugin_path = plugin_path.?,
+        .artifact_path = artifact_path,
+        .expected_compile_error_path = null,
+    };
+}
+
+fn clearStardustArtifactFamily(
+    maker: *Maker,
+    compile_index: Configuration.Step.Index,
+    session_dir: []const u8,
+    artifact_basename: []const u8,
+) Step.ExtendedMakeError!void {
+    const io = maker.graph.io;
+    var directory = Dir.cwd().openDir(io, session_dir, .{
+        .iterate = true,
+        .follow_symlinks = false,
+    }) catch |err| return maker.stepByIndex(compile_index).fail(
+        maker,
+        "failed opening Stardust build session {q}: {t}",
+        .{ session_dir, err },
+    );
+    defer directory.close(io);
+
+    var iterator = directory.iterate();
+    while (iterator.next(io) catch |err| return maker.stepByIndex(compile_index).fail(
+        maker,
+        "failed scanning Stardust build session {q}: {t}",
+        .{ session_dir, err },
+    )) |entry| {
+        if (!mem.eql(u8, entry.name, artifact_basename) and
+            (!mem.startsWith(u8, entry.name, artifact_basename) or
+                entry.name.len == artifact_basename.len or
+                entry.name[artifact_basename.len] != '.'))
+        {
+            continue;
+        }
+        directory.deleteFile(io, entry.name) catch |err|
+            return maker.stepByIndex(compile_index).fail(
+                maker,
+                "failed clearing stale Stardust artifact {q}: {t}",
+                .{ entry.name, err },
+            );
+    }
+}
+
+fn updateStardustBuildIdentity(hasher: *Sha256, field: []const u8) void {
+    const field_len: u64 = field.len;
+    hasher.update(mem.asBytes(&field_len));
+    hasher.update(field);
+}
+
+fn stardustRepositoryRelativePath(
+    arena: Allocator,
+    repository_root: []const u8,
+    absolute_path: []const u8,
+    allow_dot: bool,
+) Allocator.Error!?[]const u8 {
+    if (mem.eql(u8, repository_root, absolute_path)) {
+        return if (allow_dot) "." else null;
+    }
+    if (!mem.startsWith(u8, absolute_path, repository_root)) return null;
+    var relative = absolute_path[repository_root.len..];
+    if (repository_root.len == 0 or
+        !Dir.path.isSep(repository_root[repository_root.len - 1]))
+    {
+        if (relative.len == 0 or !Dir.path.isSep(relative[0])) return null;
+        relative = relative[1..];
+    }
+    if (relative.len == 0 or relative.len > stardust_unit_path_bytes_max) return null;
+    const normalized = try arena.dupe(u8, relative);
+    for (normalized) |*byte| {
+        if (Dir.path.isSep(byte.*)) byte.* = '/';
+    }
+    if (!stardustUnitPath(normalized, allow_dot)) return null;
+    return normalized;
+}
+
+fn stardustUnitPath(path: []const u8, allow_dot: bool) bool {
+    if (path.len == 0 or path.len > stardust_unit_path_bytes_max) return false;
+    if (allow_dot and mem.eql(u8, path, ".")) return true;
+    if (Dir.path.isAbsolute(path) or mem.indexOfScalar(u8, path, '\\') != null) {
+        return false;
+    }
+    var segments = mem.splitScalar(u8, path, '/');
+    while (segments.next()) |segment| {
+        if (segment.len == 0 or
+            mem.eql(u8, segment, ".") or
+            mem.eql(u8, segment, "..") or
+            !stardustUnitText(segment, stardust_unit_path_bytes_max))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+fn stardustUnitToken(value: []const u8) bool {
+    if (value.len == 0 or value.len > stardust_unit_text_bytes_max) return false;
+    for (value) |byte| {
+        if (!std.ascii.isAlphanumeric(byte) and
+            byte != '-' and
+            byte != '_' and
+            byte != '.' and
+            byte != '+')
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+fn stardustUnitText(value: []const u8, bytes_max: usize) bool {
+    if (value.len == 0 or value.len > bytes_max) return false;
+    for (value) |byte| {
+        if (byte < 0x20 or byte > 0x7e) return false;
+    }
+    return true;
+}
+
+fn stardustGeneratedPath(path: []const u8) bool {
+    var segments = mem.splitScalar(u8, path, '/');
+    while (segments.next()) |segment| {
+        if (mem.eql(u8, segment, ".zig-cache") or
+            mem.eql(u8, segment, "zig-cache") or
+            mem.eql(u8, segment, "zig-out"))
+        {
+            return true;
+        }
+    }
+    return false;
+}
