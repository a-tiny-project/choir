diff --git a/src/stardust.zig b/src/stardust.zig
new file mode 100644
index 00000000..794b958d
--- /dev/null
+++ b/src/stardust.zig
@@ -0,0 +1,794 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Cache = std.Build.Cache;
+const Io = std.Io;
+const fs = std.fs;
+const Air = @import("Air.zig");
+const InternPool = @import("InternPool.zig");
+const Zcu = @import("Zcu.zig");
+const api = @import("stardust_api.zig");
+
+pub const OpenError = Allocator.Error || std.DynLib.Error ||
+    api.CompatibilityError || error{
+    MissingDescriptor,
+    MissingInit,
+    PluginRejected,
+};
+
+pub const CallbackError = error{PluginFailed};
+
+const ClaimTable = struct {
+    rows: [api.metadata_records_max]api.ClaimRow = undefined,
+    next: std.atomic.Value(u32) = .init(0),
+    overflowed: std.atomic.Value(bool) = .init(false),
+
+    fn append(self: *ClaimTable, row: api.ClaimRow) void {
+        const capacity: u32 = api.metadata_records_max;
+        var index = self.next.load(.monotonic);
+        while (index < capacity) {
+            if (self.next.cmpxchgWeak(
+                index,
+                index + 1,
+                .monotonic,
+                .monotonic,
+            )) |current| {
+                index = current;
+                continue;
+            }
+            self.rows[index] = row;
+            return;
+        }
+        self.overflowed.store(true, .monotonic);
+    }
+
+    fn reset(self: *ClaimTable) void {
+        self.next.store(0, .monotonic);
+        self.overflowed.store(false, .monotonic);
+    }
+
+    fn view(self: *const ClaimTable) api.ClaimsView {
+        const claimed = self.next.load(.acquire);
+        return .{
+            .rows = &self.rows,
+            .len = @min(claimed, @as(u32, api.metadata_records_max)),
+            .overflowed = @intFromBool(self.overflowed.load(.acquire)),
+            .reserved = @splat(0),
+        };
+    }
+};
+
+const HostContext = struct {
+    allocator: Allocator,
+    io: Io,
+    output_path: []const u8,
+    failure: *api.FailureCause,
+    stage: ?Io.File.Atomic = null,
+    stage_reader: ?Io.File = null,
+    stage_limit: u64 = 0,
+    stage_bytes: u64 = 0,
+    stage_started: u8 = 0,
+    stage_failed: bool = false,
+    output: ?Io.File.Atomic = null,
+    output_limit: u64 = 0,
+    output_bytes: u64 = 0,
+    opened: bool = false,
+    flushing: bool = false,
+    write_failed: bool = false,
+    output_started: u8 = 0,
+    output_committed: u8 = 0,
+};
+
+pub const Plugin = struct {
+    lib: std.DynLib = undefined,
+    plugin: api.Plugin = undefined,
+    allocator: Allocator = undefined,
+    host_context: *HostContext = undefined,
+    opened: bool = false,
+    update_started: bool = false,
+    claims: ClaimTable = .{},
+
+    pub const empty: Plugin = .{};
+
+    const snapshot_cache_subdir = ".stardust";
+    const snapshot_cache_basename = "snapshot";
+    const snapshot_family_files_max = 64;
+
+    pub fn beginUpdate(self: *Plugin) CallbackError!void {
+        const host = self.host_context;
+        self.update_started = false;
+        _ = abortOutput(host);
+        _ = discardStage(host);
+        self.plugin.failure = .empty;
+        self.claims.reset();
+        host.stage_limit = 0;
+        host.stage_bytes = 0;
+        host.stage_started = 0;
+        host.stage_failed = false;
+        host.output_limit = 0;
+        host.output_bytes = 0;
+        host.output_started = 0;
+        host.output_committed = 0;
+        host.flushing = false;
+        host.write_failed = false;
+        const status = self.plugin.begin_update(self.plugin.context);
+        const reset_complete = host.stage == null and
+            host.stage_reader == null and
+            host.output == null;
+        if (status != api.status_ok or !reset_complete) {
+            self.plugin.failure.set(
+                .protocol,
+                "update reset status={d} reset_complete={}",
+                .{ status, reset_complete },
+            );
+            return error.PluginFailed;
+        }
+        self.update_started = true;
+    }
+
+    pub fn open(
+        self: *Plugin,
+        path: []const u8,
+        output_path: []const u8,
+        allocator: Allocator,
+        io: Io,
+    ) OpenError!void {
+        self.allocator = allocator;
+        self.plugin.failure = .empty;
+        self.host_context = try allocator.create(HostContext);
+        self.host_context.* = .{
+            .allocator = allocator,
+            .io = io,
+            .output_path = output_path,
+            .failure = &self.plugin.failure,
+        };
+        errdefer allocator.destroy(self.host_context);
+
+        self.lib = try .open(path);
+        errdefer self.lib.close();
+
+        const descriptor = self.lib.lookup(
+            *const api.Descriptor,
+            api.descriptor_symbol,
+        ) orelse return error.MissingDescriptor;
+        try api.ensureCompatible(descriptor);
+
+        const init = self.lib.lookup(api.Init, api.init_symbol) orelse
+            return error.MissingInit;
+        const host: api.Host = .{
+            .descriptor = api.descriptor,
+            .context = self.host_context,
+            .allocator = .{
+                .alloc = hostAlloc,
+                .resize = hostResize,
+                .remap = hostRemap,
+                .free = hostFree,
+            },
+            .stage_begin = stageBegin,
+            .stage_write = stageWrite,
+            .stage_seal = stageSeal,
+            .stage_read = stageRead,
+            .stage_discard = stageDiscard,
+            .begin_output = beginOutput,
+            .write_output = writeOutput,
+            .finish_output = finishOutput,
+        };
+        if (init(&host, &self.plugin) != api.status_ok)
+            return error.PluginRejected;
+        try api.ensureCompatible(&self.plugin.descriptor);
+
+        self.host_context.opened = true;
+        self.opened = true;
+    }
+
+    pub fn deinit(self: *Plugin) void {
+        if (!self.opened) return;
+        _ = abortOutput(self.host_context);
+        _ = discardStage(self.host_context);
+        self.plugin.deinit(self.plugin.context);
+        self.lib.close();
+        self.allocator.destroy(self.host_context);
+        self.opened = false;
+    }
+
+    pub fn analyze(
+        self: *Plugin,
+        pt: Zcu.PerThread,
+        func_index: InternPool.Index,
+        air: *const Air,
+    ) CallbackError!void {
+        const status = self.plugin.analyze(
+            self.plugin.context,
+            @ptrCast(&pt),
+            @backingInt(func_index),
+            @ptrCast(air),
+        );
+        if (status != api.status_ok) {
+            self.plugin.failure.set(
+                .protocol,
+                "analysis callback returned status={d} without a cause",
+                .{status},
+            );
+            return error.PluginFailed;
+        }
+    }
+
+    pub fn failureCause(self: *const Plugin) api.FailureCause {
+        return self.plugin.failure;
+    }
+
+    pub fn recordClaim(self: *Plugin, row: api.ClaimRow) void {
+        self.claims.append(row);
+    }
+
+    pub fn flush(
+        self: *Plugin,
+        zcu: *const Zcu,
+        tid: Zcu.PerThread.Id,
+    ) CallbackError!void {
+        if (self.host_context.output != null) {
+            self.plugin.failure.set(
+                .host,
+                "output transaction remains open before flush",
+                .{},
+            );
+            _ = abortOutput(self.host_context);
+            return error.PluginFailed;
+        }
+        self.host_context.write_failed = false;
+        self.host_context.output_started = 0;
+        self.host_context.output_committed = 0;
+        self.host_context.flushing = true;
+        defer self.host_context.flushing = false;
+        const claims = self.claims.view();
+        const status = self.plugin.flush(
+            self.plugin.context,
+            @ptrCast(zcu),
+            @backingInt(tid),
+            &claims,
+        );
+        const publication_complete = self.host_context.output == null and
+            self.host_context.stage == null and
+            self.host_context.stage_reader == null and
+            !self.host_context.stage_failed and
+            self.host_context.output_started >= 1 and
+            self.host_context.output_started <= 2 and
+            self.host_context.output_committed == 1 and
+            self.host_context.output_bytes > 0;
+        if (status != api.status_ok or self.host_context.write_failed or
+            !publication_complete)
+        {
+            self.plugin.failure.set(
+                .protocol,
+                "flush status={d} write_failed={} publication_complete={}",
+                .{ status, self.host_context.write_failed, publication_complete },
+            );
+            _ = abortOutput(self.host_context);
+            _ = discardStage(self.host_context);
+            return error.PluginFailed;
+        }
+        self.host_context.stage_started = 0;
+        self.host_context.stage_failed = false;
+        self.update_started = false;
+    }
+
+    pub fn persistSnapshot(
+        self: *Plugin,
+        local_cache: Cache.Directory,
+        digest: Cache.BinDigest,
+    ) !void {
+        const io = self.host_context.io;
+        const output_path = self.host_context.output_path;
+        const output_dirname = fs.path.dirname(output_path) orelse ".";
+        const output_basename = fs.path.basename(output_path);
+        var output_dir = try Io.Dir.cwd().openDir(io, output_dirname, .{
+            .iterate = true,
+            .follow_symlinks = false,
+        });
+        defer output_dir.close(io);
+
+        var cache_path_storage: [Io.Dir.max_path_bytes]u8 = undefined;
+        const cache_path = try snapshotCachePath(&cache_path_storage, digest);
+        var cache_dir = try local_cache.handle.createDirPathOpen(io, cache_path, .{
+            .open_options = .{
+                .iterate = true,
+                .follow_symlinks = false,
+            },
+        });
+        defer cache_dir.close(io);
+
+        var found_main = false;
+        var file_count: usize = 0;
+        var iterator = output_dir.iterate();
+        while (try iterator.next(io)) |entry| {
+            const suffix = snapshotFamilySuffix(output_basename, entry.name) orelse
+                continue;
+            if (file_count >= snapshot_family_files_max)
+                return error.SnapshotFamilyCapacityExceeded;
+            const stat = try output_dir.statFile(io, entry.name, .{
+                .follow_symlinks = false,
+            });
+            if (stat.kind != .file or stat.size == 0)
+                return error.InvalidSnapshotFamilyMember;
+            var cache_name_storage: [Io.Dir.max_name_bytes]u8 = undefined;
+            const cache_name = try std.fmt.bufPrint(
+                &cache_name_storage,
+                "{s}{s}",
+                .{ snapshot_cache_basename, suffix },
+            );
+            try output_dir.copyFile(entry.name, cache_dir, cache_name, io, .{});
+            found_main = found_main or suffix.len == 0;
+            file_count += 1;
+        }
+        if (!found_main) return error.MissingSnapshot;
+    }
+
+    pub fn restoreSnapshot(
+        self: *Plugin,
+        local_cache: Cache.Directory,
+        digest: Cache.BinDigest,
+    ) !void {
+        const io = self.host_context.io;
+        var cache_path_storage: [Io.Dir.max_path_bytes]u8 = undefined;
+        const cache_path = try snapshotCachePath(&cache_path_storage, digest);
+        var cache_dir = try local_cache.handle.openDir(io, cache_path, .{
+            .iterate = true,
+            .follow_symlinks = false,
+        });
+        defer cache_dir.close(io);
+
+        const output_path = self.host_context.output_path;
+        const output_dirname = fs.path.dirname(output_path) orelse ".";
+        const output_basename = fs.path.basename(output_path);
+        var output_dir = try Io.Dir.cwd().openDir(io, output_dirname, .{
+            .follow_symlinks = false,
+        });
+        defer output_dir.close(io);
+
+        var found_main = false;
+        var file_count: usize = 0;
+        var iterator = cache_dir.iterate();
+        while (try iterator.next(io)) |entry| {
+            const suffix = snapshotFamilySuffix(snapshot_cache_basename, entry.name) orelse
+                continue;
+            if (file_count >= snapshot_family_files_max)
+                return error.SnapshotFamilyCapacityExceeded;
+            const stat = try cache_dir.statFile(io, entry.name, .{
+                .follow_symlinks = false,
+            });
+            if (stat.kind != .file or stat.size == 0)
+                return error.InvalidSnapshotFamilyMember;
+            var output_name_storage: [Io.Dir.max_name_bytes]u8 = undefined;
+            const output_name = try std.fmt.bufPrint(
+                &output_name_storage,
+                "{s}{s}",
+                .{ output_basename, suffix },
+            );
+            try cache_dir.copyFile(entry.name, output_dir, output_name, io, .{});
+            found_main = found_main or suffix.len == 0;
+            file_count += 1;
+        }
+        if (!found_main) return error.MissingSnapshot;
+    }
+
+    fn snapshotCachePath(
+        storage: *[Io.Dir.max_path_bytes]u8,
+        digest: Cache.BinDigest,
+    ) std.fmt.BufPrintError![]const u8 {
+        const hex_digest = Cache.binToHex(digest);
+        return std.fmt.bufPrint(
+            storage,
+            "o{s}{s}{s}{s}",
+            .{
+                fs.path.sep_str,
+                hex_digest[0..],
+                fs.path.sep_str,
+                snapshot_cache_subdir,
+            },
+        );
+    }
+
+    fn snapshotFamilySuffix(
+        basename: []const u8,
+        candidate: []const u8,
+    ) ?[]const u8 {
+        if (std.mem.eql(u8, candidate, basename)) return candidate[candidate.len..];
+        if (!std.mem.startsWith(u8, candidate, basename)) return null;
+        if (candidate.len == basename.len or candidate[basename.len] != '.') return null;
+        return candidate[basename.len..];
+    }
+
+    fn fromContext(context: ?*anyopaque) *HostContext {
+        return @ptrCast(@alignCast(context.?));
+    }
+
+    fn hostFailure(
+        host: *HostContext,
+        comptime format_text: []const u8,
+        arguments: anytype,
+    ) u32 {
+        host.failure.set(.host, format_text, arguments);
+        return api.status_failed;
+    }
+
+    fn hostAlloc(
+        context: ?*anyopaque,
+        len: usize,
+        alignment: u8,
+        return_address: usize,
+    ) callconv(.c) ?[*]u8 {
+        const host = fromContext(context);
+        return host.allocator.rawAlloc(
+            len,
+            @fromBackingInt(@intCast(alignment)),
+            return_address,
+        );
+    }
+
+    fn hostResize(
+        context: ?*anyopaque,
+        pointer: ?[*]u8,
+        len: usize,
+        alignment: u8,
+        new_len: usize,
+        return_address: usize,
+    ) callconv(.c) bool {
+        const host = fromContext(context);
+        return host.allocator.rawResize(
+            pointer.?[0..len],
+            @fromBackingInt(@intCast(alignment)),
+            new_len,
+            return_address,
+        );
+    }
+
+    fn hostRemap(
+        context: ?*anyopaque,
+        pointer: ?[*]u8,
+        len: usize,
+        alignment: u8,
+        new_len: usize,
+        return_address: usize,
+    ) callconv(.c) ?[*]u8 {
+        const host = fromContext(context);
+        return host.allocator.rawRemap(
+            pointer.?[0..len],
+            @fromBackingInt(@intCast(alignment)),
+            new_len,
+            return_address,
+        );
+    }
+
+    fn hostFree(
+        context: ?*anyopaque,
+        pointer: ?[*]u8,
+        len: usize,
+        alignment: u8,
+        return_address: usize,
+    ) callconv(.c) void {
+        const host = fromContext(context);
+        host.allocator.rawFree(
+            pointer.?[0..len],
+            @fromBackingInt(@intCast(alignment)),
+            return_address,
+        );
+    }
+
+    fn stageBegin(
+        context: ?*anyopaque,
+        max_bytes: u64,
+    ) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.opened or host.flushing or host.stage != null or
+            host.stage_reader != null or host.stage_started != 0 or
+            max_bytes == 0 or max_bytes > api.stage_hard_limit)
+        {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-begin rejected max_bytes={d} hard_limit={d}",
+                .{ max_bytes, api.stage_hard_limit },
+            );
+        }
+        host.stage = Io.Dir.cwd().createFileAtomic(
+            host.io,
+            host.output_path,
+            .{ .replace = true },
+        ) catch |err| {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-begin error={t}", .{err});
+        };
+        host.stage_limit = max_bytes;
+        host.stage_bytes = 0;
+        host.stage_started = 1;
+        return api.status_ok;
+    }
+
+    fn stageWrite(
+        context: ?*anyopaque,
+        pointer: [*]const u8,
+        len: usize,
+        offset: *u64,
+    ) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (host.flushing or host.stage == null or host.stage_reader != null) {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-write rejected bytes={d} offset={d} limit={d}",
+                .{ len, host.stage_bytes, host.stage_limit },
+            );
+        }
+        const next = std.math.add(u64, host.stage_bytes, len) catch {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-write offset overflow at offset={d} bytes={d}",
+                .{ host.stage_bytes, len },
+            );
+        };
+        if (next > host.stage_limit) {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-write requires bytes={d} with limit={d}",
+                .{ next, host.stage_limit },
+            );
+        }
+        const stage = &host.stage.?;
+        stage.file.writeStreamingAll(host.io, pointer[0..len]) catch |err| {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-write error={t}", .{err});
+        };
+        offset.* = host.stage_bytes;
+        host.stage_bytes = next;
+        return api.status_ok;
+    }
+
+    fn stageSeal(context: ?*anyopaque) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.flushing or host.stage == null or
+            host.stage_reader != null)
+        {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-seal rejected its phase", .{});
+        }
+        const stage = &host.stage.?;
+        if (stage.file_open) {
+            stage.file.close(host.io);
+            stage.file_open = false;
+        }
+        if (!stage.file_exists) {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-seal lost its temporary file", .{});
+        }
+        const temporary = std.fmt.hex(stage.file_basename_hex);
+        host.stage_reader = stage.dir.openFile(
+            host.io,
+            &temporary,
+            .{ .allow_directory = false, .follow_symlinks = false },
+        ) catch |err| {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-seal error={t}", .{err});
+        };
+        return api.status_ok;
+    }
+
+    fn stageRead(
+        context: ?*anyopaque,
+        offset: u64,
+        pointer: [*]u8,
+        len: usize,
+    ) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.flushing or host.stage_reader == null) {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-read rejected its phase", .{});
+        }
+        const reader = host.stage_reader.?;
+        const end = std.math.add(u64, offset, len) catch {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-read offset overflow at offset={d} bytes={d}",
+                .{ offset, len },
+            );
+        };
+        if (end > host.stage_bytes) {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-read requires end={d} with bytes={d}",
+                .{ end, host.stage_bytes },
+            );
+        }
+        const read = reader.readPositionalAll(
+            host.io,
+            pointer[0..len],
+            offset,
+        ) catch |err| {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-read error={t}", .{err});
+        };
+        if (read != len) {
+            host.stage_failed = true;
+            return hostFailure(
+                host,
+                "stage-read returned bytes={d} with requested={d}",
+                .{ read, len },
+            );
+        }
+        return api.status_ok;
+    }
+
+    fn stageDiscard(context: ?*anyopaque) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.flushing) {
+            host.stage_failed = true;
+            return hostFailure(host, "stage-discard rejected its phase", .{});
+        }
+        if (discardStage(host)) return api.status_ok;
+        host.stage_failed = true;
+        return hostFailure(host, "stage-discard could not remove its file", .{});
+    }
+
+    fn beginOutput(
+        context: ?*anyopaque,
+        max_bytes: u64,
+    ) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.opened or !host.flushing or host.output != null or
+            host.output_started >= 2 or host.output_committed != 0 or
+            max_bytes == 0 or max_bytes > api.output_hard_limit)
+        {
+            host.write_failed = true;
+            return hostFailure(
+                host,
+                "output-begin rejected max_bytes={d} hard_limit={d}",
+                .{ max_bytes, api.output_hard_limit },
+            );
+        }
+        host.output = Io.Dir.cwd().createFileAtomic(
+            host.io,
+            host.output_path,
+            .{ .replace = true },
+        ) catch |err| {
+            host.write_failed = true;
+            return hostFailure(host, "output-begin error={t}", .{err});
+        };
+        host.output_started += 1;
+        host.output_limit = max_bytes;
+        host.output_bytes = 0;
+        return api.status_ok;
+    }
+
+    fn writeOutput(
+        context: ?*anyopaque,
+        pointer: [*]const u8,
+        len: usize,
+    ) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.flushing or host.output == null) {
+            host.write_failed = true;
+            return hostFailure(host, "output-write rejected its phase", .{});
+        }
+        const next = std.math.add(u64, host.output_bytes, len) catch {
+            host.write_failed = true;
+            return hostFailure(
+                host,
+                "output-write offset overflow at offset={d} bytes={d}",
+                .{ host.output_bytes, len },
+            );
+        };
+        if (next > host.output_limit) {
+            host.write_failed = true;
+            return hostFailure(
+                host,
+                "output-write requires bytes={d} with limit={d}",
+                .{ next, host.output_limit },
+            );
+        }
+        const output = &host.output.?;
+        output.file.writeStreamingAll(host.io, pointer[0..len]) catch |err| {
+            host.write_failed = true;
+            return hostFailure(host, "output-write error={t}", .{err});
+        };
+        host.output_bytes = next;
+        return api.status_ok;
+    }
+
+    fn finishOutput(
+        context: ?*anyopaque,
+        commit: u8,
+    ) callconv(.c) u32 {
+        const host = fromContext(context);
+        if (!host.flushing or host.output == null or commit > 1) {
+            host.write_failed = true;
+            return hostFailure(
+                host,
+                "output-finish rejected commit={d}",
+                .{commit},
+            );
+        }
+        const output = &host.output.?;
+        if (commit == 0) {
+            if (abortOutput(host)) return api.status_ok;
+            return hostFailure(host, "output-abort could not remove its file", .{});
+        }
+        output.file.sync(host.io) catch |err| {
+            host.write_failed = true;
+            return hostFailure(host, "output-sync error={t}", .{err});
+        };
+        output.replace(host.io) catch |err| {
+            host.write_failed = true;
+            return hostFailure(host, "output-commit error={t}", .{err});
+        };
+        output.deinit(host.io);
+        host.output = null;
+        host.output_limit = 0;
+        host.output_committed = 1;
+        return api.status_ok;
+    }
+
+    fn abortOutput(host: *HostContext) bool {
+        if (host.output == null) return true;
+        const output = &host.output.?;
+        if (output.file_open) {
+            output.file.close(host.io);
+            output.file_open = false;
+        }
+        if (output.file_exists) {
+            const temporary = std.fmt.hex(output.file_basename_hex);
+            var deleted = true;
+            output.dir.deleteFile(host.io, &temporary) catch {
+                host.write_failed = true;
+                deleted = false;
+            };
+            output.file_exists = false;
+            if (!deleted) {
+                if (output.close_dir_on_deinit) {
+                    output.dir.close(host.io);
+                    output.close_dir_on_deinit = false;
+                }
+                output.* = undefined;
+                host.output = null;
+                return false;
+            }
+        }
+        if (output.close_dir_on_deinit) {
+            output.dir.close(host.io);
+            output.close_dir_on_deinit = false;
+        }
+        output.* = undefined;
+        host.output = null;
+        host.output_limit = 0;
+        return true;
+    }
+
+    fn discardStage(host: *HostContext) bool {
+        if (host.stage_reader) |reader| reader.close(host.io);
+        host.stage_reader = null;
+        host.stage_limit = 0;
+        host.stage_bytes = 0;
+        if (host.stage == null) return true;
+        const stage = &host.stage.?;
+        if (stage.file_open) {
+            stage.file.close(host.io);
+            stage.file_open = false;
+        }
+        var deleted = true;
+        if (stage.file_exists) {
+            const temporary = std.fmt.hex(stage.file_basename_hex);
+            stage.dir.deleteFile(host.io, &temporary) catch {
+                deleted = false;
+            };
+            stage.file_exists = false;
+        }
+        if (stage.close_dir_on_deinit) {
+            stage.dir.close(host.io);
+            stage.close_dir_on_deinit = false;
+        }
+        stage.* = undefined;
+        host.stage = null;
+        return deleted;
+    }
+};
