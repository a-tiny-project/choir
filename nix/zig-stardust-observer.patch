+fn zirStardustClaim(
+    sema: *Sema,
+    block: *Block,
+    extended: Zir.Inst.Extended.InstData,
+) CompileError!Air.Inst.Ref {
+    const extra = sema.code.extraData(Zir.Inst.NodeMultiOp, extended.operand);
+    const src = block.nodeOffset(extra.data.src_node);
+    const args = sema.code.refSlice(extra.end, extended.small);
+    assert(args.len == 7);
+    if (!block.isComptime()) {
+        return sema.fail(block, src, "@stardustClaim requires comptime execution", .{});
+    }
+    const comp = sema.pt.zcu.comp;
+    if (!comp.config.stardust_claim_metadata or comp.stardust_plugin == null) {
+        return .void_value;
+    }
+    const plugin = &comp.stardust_plugin.?;
+    sema.allow_memoize = false;
+
+    var values: [7]InternPool.Index = undefined;
+    var available: [7]bool = undefined;
+    for (args, 0..) |arg_ref, index| {
+        const arg = sema.resolveInst(arg_ref);
+        const value = sema.resolveValue(arg);
+        available[index] = value != null;
+        values[index] = if (value) |resolved|
+            resolved.toIntern()
+        else
+            .none;
+    }
+    if (!available[0]) {
+        return sema.fail(block, src, "@stardustClaim requires an evaluated claim", .{});
+    }
+
+    const roles = [_]stardust_api.ClaimReferenceRole{
+        .owner_family,
+        .default_limits,
+        .seal,
+        .seal_premise,
+        .teardown,
+        .teardown_premise,
+    };
+    var row: stardust_api.ClaimRow = .{
+        .claim_value = @backingInt(values[0]),
+        .test_function = @backingInt(InternPool.Index.none),
+        .test_function_available = 0,
+        .reserved = @splat(0),
+        .references = undefined,
+    };
+    switch (sema.owner.unwrap()) {
+        .func => |function| {
+            const nav = sema.pt.zcu.funcInfo(function).owner_nav;
+            if (sema.pt.zcu.test_functions.contains(nav)) {
+                row.test_function = @backingInt(function);
+                row.test_function_available = 1;
+            }
+        },
+        else => {},
+    }
+    for (&row.references, roles, values[1..], available[1..]) |
+        *reference,
+        role,
+        value,
+        is_available,
+    | {
+        reference.* = .{
+            .value = @backingInt(value),
+            .role = role,
+            .available = @intFromBool(is_available),
+            .reserved = @splat(0),
+        };
+    }
+    plugin.recordClaim(row);
+    return .void_value;
+}
