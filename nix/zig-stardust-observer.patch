+const StardustBuildTicket = struct {
+    plugin_path: ?[]const u8,
+    artifact_path: ?[]const u8,
+    expected_compile_error_path: ?[]const u8,
+
+    fn appendObserverArgs(
+        ticket: StardustBuildTicket,
+        arena: Allocator,
+        gpa: Allocator,
+        zig_args: *std.ArrayList([]const u8),
+    ) Allocator.Error!void {
+        const artifact_path = ticket.artifact_path orelse return;
+        try zig_args.appendSlice(gpa, &.{
+            try arena.print("-fstardust-plugin={s}", .{ticket.plugin_path.?}),
+            try arena.print("-fstardust-output={s}", .{artifact_path}),
+        });
+    }
+
+    fn observerArgsLength(ticket: StardustBuildTicket) usize {
+        const artifact_path = ticket.artifact_path orelse return 0;
+        return "-fstardust-plugin=".len + ticket.plugin_path.?.len + 1 +
+            "-fstardust-output=".len + artifact_path.len + 1;
+    }
+
+    fn markExpectedCompileError(
+        ticket: StardustBuildTicket,
+        maker: *Maker,
+        compile_index: Configuration.Step.Index,
+    ) Step.ExtendedMakeError!void {
+        const terminal_path = ticket.expected_compile_error_path orelse
+            return maker.stepByIndex(compile_index).fail(
+                maker,
+                "Stardust build ticket expected an artifact, not a compile error",
+                .{},
+            );
+        const io = maker.graph.io;
+        const terminal = Dir.cwd().createFile(io, terminal_path, .{}) catch |err|
+            return maker.stepByIndex(compile_index).fail(
+                maker,
+                "failed creating Stardust build terminal {q}: {t}",
+                .{ terminal_path, err },
+            );
+        terminal.close(io);
+    }
+
+    fn requireArtifact(
+        ticket: StardustBuildTicket,
+        maker: *Maker,
+        compile_index: Configuration.Step.Index,
+    ) Step.ExtendedMakeError!void {
+        const artifact_path = ticket.artifact_path orelse
+            return maker.stepByIndex(compile_index).fail(
+                maker,
+                "Stardust build expected a compile error but compilation succeeded",
+                .{},
+            );
+        const stat = Dir.cwd().statFile(maker.graph.io, artifact_path, .{
+            .follow_symlinks = false,
+        }) catch |err| return maker.stepByIndex(compile_index).fail(
+            maker,
+            "Stardust build compiler produced no artifact at {q}: {t}",
+            .{ artifact_path, err },
+        );
+        if (stat.kind != .file or stat.size == 0) {
+            return maker.stepByIndex(compile_index).fail(
+                maker,
+                "Stardust build artifact {q} must be a non-empty regular file; found {t} with {d} bytes",
+                .{ artifact_path, stat.kind, stat.size },
+            );
+        }
+    }
+};
