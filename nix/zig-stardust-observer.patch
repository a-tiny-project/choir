@@ -0,0 +1,400 @@
+const std = @import("std");
+const builtin = @import("builtin");
+const build_options = @import("build_options");
+const Air = @import("Air.zig");
+const InternPool = @import("InternPool.zig");
+const Zcu = @import("Zcu.zig");
+
+pub const api_epoch: u32 = 8;
+pub const source_identity = "tiny.zig.source.identity";
+pub const fork_identity = "tiny.zig.fork.identity";
+pub const descriptor_symbol: [:0]const u8 =
+    "tiny_stardust_plugin_descriptor_v8";
+pub const init_symbol: [:0]const u8 = "tiny_stardust_plugin_init_v8";
+
+pub const status_ok: u32 = 0;
+pub const status_incompatible: u32 = 1;
+pub const status_failed: u32 = 2;
+pub const stage_hard_limit: u64 = 2_147_483_648;
+pub const output_hard_limit: u64 = 1_073_741_824;
+pub const claim_declarations_max: usize = 256;
+pub const claim_reference_count: usize = 6;
+pub const test_witnesses_max: usize = claim_declarations_max * 24;
+pub const metadata_records_max: usize = claim_declarations_max + test_witnesses_max;
+pub const failure_text_bytes_max: usize = 256;
+
+pub const FailureTag = enum(u32) {
+    none,
+    initialization,
+    analysis,
+    unit,
+    phase,
+    capacity,
+    shape,
+    publish,
+    host,
+    protocol,
+};
+
+pub const FailureCause = extern struct {
+    tag: FailureTag,
+    text_len: u32,
+    text: [failure_text_bytes_max]u8,
+
+    pub const empty: FailureCause = .{
+        .tag = .none,
+        .text_len = 0,
+        .text = @splat(0),
+    };
+
+    pub fn set(
+        self: *FailureCause,
+        tag: FailureTag,
+        comptime format_text: []const u8,
+        arguments: anytype,
+    ) void {
+        if (self.tag != .none) return;
+        const written = std.fmt.bufPrint(
+            &self.text,
+            format_text,
+            arguments,
+        ) catch fallback: {
+            const value = "failure details exceed the API text capacity";
+            @memcpy(self.text[0..value.len], value);
+            break :fallback self.text[0..value.len];
+        };
+        self.text_len = @intCast(written.len);
+        self.tag = tag;
+    }
+
+    pub fn details(self: *const FailureCause) []const u8 {
+        const len = @min(self.text_len, failure_text_bytes_max);
+        return self.text[0..len];
+    }
+
+    pub fn format(
+        self: FailureCause,
+        writer: *std.Io.Writer,
+    ) std.Io.Writer.Error!void {
+        const tag = if (self.tag == .none) "unreported" else @tagName(self.tag);
+        const detail = if (self.text_len == 0) "plugin supplied no details" else self.details();
+        try writer.print("{s}: {s}. ", .{ tag, detail });
+        try writer.writeAll(
+            "Correct the reported condition, or report this cause with " ++
+                "the failing compile unit. Rerun the same Stardust build command.",
+        );
+    }
+};
+
+pub const ClaimReferenceRole = enum(u8) {
+    owner_family,
+    default_limits,
+    seal,
+    seal_premise,
+    teardown,
+    teardown_premise,
+};
+
+comptime {
+    if (@typeInfo(ClaimReferenceRole).@"enum".field_names.len != claim_reference_count) {
+        @compileError("Claim reference count differs from its role enum");
+    }
+}
+
+pub const ClaimReference = extern struct {
+    value: u32,
+    role: ClaimReferenceRole,
+    available: u8,
+    reserved: [2]u8,
+};
+
+pub const ClaimRow = extern struct {
+    claim_value: u32,
+    test_function: u32,
+    test_function_available: u8,
+    reserved: [3]u8,
+    references: [claim_reference_count]ClaimReference,
+};
+
+pub const ClaimsView = extern struct {
+    rows: [*]const ClaimRow,
+    len: u32,
+    overflowed: u8,
+    reserved: [3]u8,
+};
+
+const api_schema =
+    \\tiny.stardust.api.8
+    \\Descriptor{size:u32,api_epoch:u32,api_digest:[32]u8,fork_digest:[32]u8,source_commit:[40]u8,build_options_digest:[32]u8,private_layout_digest:[32]u8,host_size:u32,plugin_size:u32,host_triple_len:u8,host_triple:[96]u8,optimize_mode:u8,pointer_bits:u8,endian:u8}
+    \\AllocatorVTable{alloc,resize,remap,free}
+    \\FailureTag{none,initialization,analysis,unit,phase,capacity,shape,publish,host,protocol}
+    \\FailureCause{tag:u32,text_len:u32,text:[256]u8}
+    \\ClaimReferenceRole{owner_family,default_limits,seal,seal_premise,teardown,teardown_premise}
+    \\ClaimReference{value:u32,role:u8,available:u8,reserved:[2]u8}
+    \\ClaimRow{claim_value:u32,test_function:u32,test_function_available:u8,reserved:[3]u8,references:[6]ClaimReference}
+    \\ClaimsView{rows:ClaimRow*,len:u32,overflowed:u8,reserved:[3]u8}
+    \\claim_declarations_max=256
+    \\test_witnesses_max=6144
+    \\metadata_records_max=6400
+    \\Host{descriptor,context,allocator,stage_begin,stage_write,stage_seal,stage_read,stage_discard,begin_output,write_output,finish_output}
+    \\stage_hard_limit=2147483648
+    \\output_hard_limit=1073741824
+    \\stage_begin(context,max_bytes)u32
+    \\stage_write(context,bytes,out_offset)u32
+    \\stage_seal(context)u32
+    \\stage_read(context,offset,bytes)u32
+    \\stage_discard(context)u32
+    \\begin_output(context,max_bytes)u32
+    \\write_output(context,bytes)u32
+    \\finish_output(context,commit:0|1)u32
+    \\Plugin{descriptor,context,failure,begin_update,analyze,flush,deinit}
+    \\begin_update(context)u32
+    \\analyze(context,PerThread*,InternPool.Index,Air*)u32
+    \\flush(context,Zcu*,PerThread.Id,ClaimsView*)u32
+;
+
+const build_options_schema = std.fmt.comptimePrint(
+    "version={s};mem_leak_frames={d};have_llvm={};llvm_has_m68k={};llvm_has_csky={};llvm_has_arc={};llvm_has_xtensa={};debug_gpa={};dev={s};io_mode={s};value_interpret_mode={s};enable_debug_extensions={};enable_logging={};enable_tracy={};enable_tracy_callstack={};enable_tracy_allocation={};tracy_callstack_depth={d};value_tracing={}",
+    .{
+        build_options.version,
+        build_options.mem_leak_frames,
+        build_options.have_llvm,
+        build_options.llvm_has_m68k,
+        build_options.llvm_has_csky,
+        build_options.llvm_has_arc,
+        build_options.llvm_has_xtensa,
+        build_options.debug_gpa,
+        @tagName(build_options.dev),
+        @tagName(build_options.io_mode),
+        @tagName(build_options.value_interpret_mode),
+        build_options.enable_debug_extensions,
+        build_options.enable_logging,
+        build_options.enable_tracy,
+        build_options.enable_tracy_callstack,
+        build_options.enable_tracy_allocation,
+        build_options.tracy_callstack_depth,
+        build_options.value_tracing,
+    },
+);
+
+const private_layout_schema = std.fmt.comptimePrint(
+    "Air:size={d},align={d},instructions={d},extra={d};Air.Inst:size={d},align={d},tag={d},data={d};InternPool.Index:size={d},align={d}",
+    .{
+        @sizeOf(Air),
+        @alignOf(Air),
+        @offsetOf(Air, "instructions"),
+        @offsetOf(Air, "extra"),
+        @sizeOf(Air.Inst),
+        @alignOf(Air.Inst),
+        @offsetOf(Air.Inst, "tag"),
+        @offsetOf(Air.Inst, "data"),
+        @sizeOf(InternPool.Index),
+        @alignOf(InternPool.Index),
+    },
+) ++ std.fmt.comptimePrint(
+    ";Zcu:size={d},align={d},intern_pool={d};Zcu.PerThread:size={d},align={d},zcu={d},tid={d};Zcu.PerThread.Id:size={d},align={d};ClaimReference:size={d},align={d},value={d},role={d},available={d};ClaimRow:size={d},align={d},claim_value={d},test_function={d},test_function_available={d},references={d};ClaimsView:size={d},align={d},rows={d},len={d},overflowed={d};FailureCause:size={d},align={d},tag={d},text_len={d},text={d}",
+    .{
+        @sizeOf(Zcu),
+        @alignOf(Zcu),
+        @offsetOf(Zcu, "intern_pool"),
+        @sizeOf(Zcu.PerThread),
+        @alignOf(Zcu.PerThread),
+        @offsetOf(Zcu.PerThread, "zcu"),
+        @offsetOf(Zcu.PerThread, "tid"),
+        @sizeOf(Zcu.PerThread.Id),
+        @alignOf(Zcu.PerThread.Id),
+        @sizeOf(ClaimReference),
+        @alignOf(ClaimReference),
+        @offsetOf(ClaimReference, "value"),
+        @offsetOf(ClaimReference, "role"),
+        @offsetOf(ClaimReference, "available"),
+        @sizeOf(ClaimRow),
+        @alignOf(ClaimRow),
+        @offsetOf(ClaimRow, "claim_value"),
+        @offsetOf(ClaimRow, "test_function"),
+        @offsetOf(ClaimRow, "test_function_available"),
+        @offsetOf(ClaimRow, "references"),
+        @sizeOf(ClaimsView),
+        @alignOf(ClaimsView),
+        @offsetOf(ClaimsView, "rows"),
+        @offsetOf(ClaimsView, "len"),
+        @offsetOf(ClaimsView, "overflowed"),
+        @sizeOf(FailureCause),
+        @alignOf(FailureCause),
+        @offsetOf(FailureCause, "tag"),
+        @offsetOf(FailureCause, "text_len"),
+        @offsetOf(FailureCause, "text"),
+    },
+);
+
+pub const api_digest = digest(api_schema);
+pub const fork_digest = digest(fork_identity);
+pub const build_options_digest = digest(build_options_schema);
+pub const private_layout_digest = digest(private_layout_schema);
+pub const host_triple_text =
+    @tagName(builtin.target.cpu.arch) ++ "-" ++
+    @tagName(builtin.target.os.tag) ++ "-" ++
+    @tagName(builtin.target.abi);
+
+pub const Descriptor = extern struct {
+    size: u32,
+    api_epoch: u32,
+    api_digest: [32]u8,
+    fork_digest: [32]u8,
+    source_commit: [40]u8,
+    build_options_digest: [32]u8,
+    private_layout_digest: [32]u8,
+    host_size: u32,
+    plugin_size: u32,
+    host_triple_len: u8,
+    host_triple: [96]u8,
+    optimize_mode: u8,
+    pointer_bits: u8,
+    endian: u8,
+};
+
+pub const descriptor: Descriptor = makeDescriptor();
+
+pub const CompatibilityError = error{
+    DescriptorSizeMismatch,
+    ApiEpochMismatch,
+    ApiDigestMismatch,
+    ForkDigestMismatch,
+    SourceCommitMismatch,
+    BuildOptionsMismatch,
+    PrivateLayoutMismatch,
+    HostSizeMismatch,
+    PluginSizeMismatch,
+    HostTripleMismatch,
+    OptimizeModeMismatch,
+    PointerWidthMismatch,
+    EndianMismatch,
+};
+
+pub fn ensureCompatible(actual: *const Descriptor) CompatibilityError!void {
+    if (actual.size != @sizeOf(Descriptor))
+        return error.DescriptorSizeMismatch;
+    if (actual.api_epoch != api_epoch)
+        return error.ApiEpochMismatch;
+    if (!bytesMatch(&actual.api_digest, &api_digest))
+        return error.ApiDigestMismatch;
+    if (!bytesMatch(&actual.fork_digest, &fork_digest))
+        return error.ForkDigestMismatch;
+    if (!bytesMatch(&actual.source_commit, source_identity))
+        return error.SourceCommitMismatch;
+    if (!bytesMatch(&actual.build_options_digest, &build_options_digest))
+        return error.BuildOptionsMismatch;
+    if (!bytesMatch(&actual.private_layout_digest, &private_layout_digest))
+        return error.PrivateLayoutMismatch;
+    if (actual.host_size != @sizeOf(Host))
+        return error.HostSizeMismatch;
+    if (actual.plugin_size != @sizeOf(Plugin))
+        return error.PluginSizeMismatch;
+    if (actual.host_triple_len != host_triple_text.len or
+        !bytesMatch(
+            actual.host_triple[0..host_triple_text.len],
+            host_triple_text,
+        ))
+    {
+        return error.HostTripleMismatch;
+    }
+    if (actual.optimize_mode != @backingInt(builtin.mode))
+        return error.OptimizeModeMismatch;
+    if (actual.pointer_bits != @bitSizeOf(usize))
+        return error.PointerWidthMismatch;
+    if (actual.endian != @backingInt(builtin.target.cpu.arch.endian()))
+        return error.EndianMismatch;
+}
+
+pub fn descriptorMatches(actual: *const Descriptor) bool {
+    ensureCompatible(actual) catch return false;
+    return true;
+}
+
+pub const AllocatorVTable = extern struct {
+    alloc: *const fn (?*anyopaque, usize, u8, usize) callconv(.c) ?[*]u8,
+    resize: *const fn (?*anyopaque, ?[*]u8, usize, u8, usize, usize) callconv(.c) bool,
+    remap: *const fn (?*anyopaque, ?[*]u8, usize, u8, usize, usize) callconv(.c) ?[*]u8,
+    free: *const fn (?*anyopaque, ?[*]u8, usize, u8, usize) callconv(.c) void,
+};
+
+pub const Host = extern struct {
+    descriptor: Descriptor,
+    context: ?*anyopaque,
+    allocator: AllocatorVTable,
+    stage_begin: *const fn (?*anyopaque, u64) callconv(.c) u32,
+    stage_write: *const fn (
+        ?*anyopaque,
+        [*]const u8,
+        usize,
+        *u64,
+    ) callconv(.c) u32,
+    stage_seal: *const fn (?*anyopaque) callconv(.c) u32,
+    stage_read: *const fn (
+        ?*anyopaque,
+        u64,
+        [*]u8,
+        usize,
+    ) callconv(.c) u32,
+    stage_discard: *const fn (?*anyopaque) callconv(.c) u32,
+    begin_output: *const fn (?*anyopaque, u64) callconv(.c) u32,
+    write_output: *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) u32,
+    finish_output: *const fn (?*anyopaque, u8) callconv(.c) u32,
+};
+
+pub const Plugin = extern struct {
+    descriptor: Descriptor,
+    context: ?*anyopaque,
+    failure: FailureCause,
+    begin_update: *const fn (?*anyopaque) callconv(.c) u32,
+    analyze: *const fn (
+        ?*anyopaque,
+        *const anyopaque,
+        u32,
+        *const anyopaque,
+    ) callconv(.c) u32,
+    flush: *const fn (
+        ?*anyopaque,
+        *const anyopaque,
+        u32,
+        *const ClaimsView,
+    ) callconv(.c) u32,
+    deinit: *const fn (?*anyopaque) callconv(.c) void,
+};
+
+pub const Init = *const fn (*const Host, *Plugin) callconv(.c) u32;
+
+fn digest(comptime material: []const u8) [32]u8 {
+    @setEvalBranchQuota(100_000);
+    var result: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(material, &result, .{});
+    return result;
+}
+
+fn bytesMatch(actual: []const u8, comptime expected: []const u8) bool {
+    inline for (expected, 0..) |byte, index| {
+        if (actual[index] != byte) return false;
+    }
+    return true;
+}
+
+fn makeDescriptor() Descriptor {
+    var result: Descriptor = .{
+        .size = @sizeOf(Descriptor),
+        .api_epoch = api_epoch,
+        .api_digest = api_digest,
+        .fork_digest = fork_digest,
+        .source_commit = source_identity[0..40].*,
+        .build_options_digest = build_options_digest,
+        .private_layout_digest = private_layout_digest,
+        .host_size = @sizeOf(Host),
+        .plugin_size = @sizeOf(Plugin),
+        .host_triple_len = host_triple_text.len,
+        .host_triple = @splat(0),
+        .optimize_mode = @backingInt(builtin.mode),
+        .pointer_bits = @bitSizeOf(usize),
+        .endian = @backingInt(builtin.target.cpu.arch.endian()),
+    };
+    @memcpy(result.host_triple[0..host_triple_text.len], host_triple_text);
+    return result;
+}
